-      0x0d, 0x52, 0x46, 0x49, 0x44, 0x49, 0x4f,
-      0x74, 0x20, 0x50, 0x4e, 0x35, 0x33, 0x32 // HISTORICAL BYTES
+      0x33, 0x22, 0x11, // NFCID3t (10)
+      0x01, 0x00,       // LEN Gt=1, Gt
