+      0x00,
+      // PN532 AsTarget is 4-byte UID only (plastic is 7-byte).
+      // ATQA must advertise single-size UID (0x4400 broke SELECT on fail3).
+      0x00, 0x44,       // SENS_RES / ATQA (4-byte UID bit frame)
+      0xA2, 0x3D, 0x05, // NFCID1t (UID bytes 1..3 of plastic -> 08A23D05)
+      0x20,             // SEL_RES / SAK: ISO14443-4 compliant
       0x01, 0xfe, // NFCID2T MUST START WITH 01fe - FELICA PARAMS - POL_RES
       0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7, 0xc0,
